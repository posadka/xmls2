    def flyembed(self, url):
        try:
            data    = requests.get(url, headers={'User-Agent': UA}, timeout=TIMEOUT).json()
            results = []
            for entry in data:
                if 'iframeURL' in entry:
                    team1      = html.unescape((entry.get('Team 1 ') or entry.get('Team1') or '').strip())
                    team2      = html.unescape((entry.get('Team2') or '').strip())
                    league     = html.unescape((entry.get('League') or '').strip())
