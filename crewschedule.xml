                    if dt_str:
                        try:
                            dt = datetime.strptime(dt_str, '%Y-%m-%dT%H:%M:%S+00:00').replace(tzinfo=timezone.utc).astimezone()
                            time_str = f'[COLOR dodgerblue]{dt.strftime("%m/%d %I:%M %p").lstrip("0")}[/COLOR]'
                        except Exception:
                            pass
                label = f'{time_str} [COLOR orange]{title}[/COLOR]'.strip()
                results.append((json.dumps(links), label))
            return results or None
        except Exception as e:
            _log_error('xyzstreams', url, e)
