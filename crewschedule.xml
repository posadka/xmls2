                home = game.get('home_team') or {}
                away = game.get('visiting_team') or {}
                home_abbr = (home.get('short_name') or '').upper()
                away_abbr = (away.get('short_name') or '').upper()
                home_url  = M3U8_CHANNELS_MAP.get(home_abbr)
                away_url  = M3U8_CHANNELS_MAP.get(away_abbr)
                if not home_url and not away_url:
                    continue
                links = []
                if away_url:
                    links.append({'label': f'Away Feed ({away_abbr})', 'url': away_url})
                if home_url:
                    links.append({'label': f'Home Feed ({home_abbr})', 'url': home_url})
                title  = f'{away.get("name") or away_abbr} @ {home.get("name") or home_abbr}'
                status = (game.get('game_status') or '').lower()
                clock  = (game.get('clock') or '').strip()
                if status in ('in progress', 'live') and clock and not clock.lower().startswith('0 '):
                    time_str = '[COLOR red]LIVE[/COLOR]'
                elif status in ('final', 'completed'):
                    time_str = '[COLOR gray]FINAL[/COLOR]'
