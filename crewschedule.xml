    @staticmethod
    def _fmt_utc_ts(ts, fmt='%m/%d %I:%M %p'):
        try:
            dt = _to_local(datetime.fromtimestamp(int(ts), tz=timezone.utc))
            return dt.strftime(fmt).lstrip('0')
        except Exception:
            return ''

    @staticmethod
    def _fmt_utc_dt(dt_str, in_fmt='%Y-%m-%d %H:%M:%S', out_fmt='%m/%d %I:%M %p'):
        try:
            dt = _to_local(datetime.strptime(dt_str, in_fmt).replace(tzinfo=timezone.utc))
            return dt.strftime(out_fmt).lstrip('0')
        except Exception:
            return ''

    @staticmethod
    def _label(time_str, title):
        if time_str:
            return f'[COLOR dodgerblue]{time_str}[/COLOR] [COLOR orange]{title}[/COLOR]'
        return f'[COLOR orange]{title}[/COLOR]'

    @_guard
    def rampages(self, url):
        try:
            page_data = requests.get(url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
            base      = _base_url(url)
            matches   = re.findall(
                r'(?s)<tr><td data-sort="\*[^"]*"><a href="([^"]+)">'
                r'<img class="icon" src="[^"]*" alt="Directory">([^<]+)</a></td>'
                r'<td data-sort="[^"]*">([^<]+)</td>',
                page_data
            )
            entries = []
            for href, name, dt_str in matches:
                name  = html.unescape(name).strip()
                title = name.replace('-vs-', ' vs ').replace('-', ' ').title()
                dt_str = dt_str.strip()
                try:
                    dt        = datetime.strptime(dt_str, '%Y-%m-%d %H:%M').replace(tzinfo=timezone.utc)
                    time_str  = _to_local(dt).strftime('%m/%d %I:%M %p').lstrip('0')
                    sort_key  = dt
                except Exception:
                    time_str  = dt_str
                    sort_key  = datetime.max.replace(tzinfo=timezone.utc)
                full_url = urljoin(base, href)
                entries.append((sort_key, full_url, self._label(time_str, title)))
            entries.sort(key=lambda e: e[0])
            results = [(u, l) for _, u, l in entries]
            return results or None
        except Exception as e:
            _log_error('rampages', url, e)
            return None

    @_guard
    def streameast(self, url):
        try:
            page_data = requests.get(url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
            matches = re.findall(
                r'(?s)<li[^>]*\bclass=["\'][^"\']*\bf1-podium--item\b[^"\']*["\'][^>]*>\s*'
                r'<a\s+href=["\']([^"\']+)["\'].*?'
                r'f1-podium--rank[^>]*>([^<]+)</span>.*?'
                r'd-md-inline[^>]*>\s*([^<]+?)\s*</span>.*?'
                r'<span[^>]*\bclass=["\']([^"\']*f1-podium--time[^"\']*)["\'][^>]*\bdata-zaman=["\'](\d+)["\'][^>]*>',
                page_data
            )
            results = []
            for href, league, teams, time_cls, epoch in matches:
                href    = html.unescape(href).strip()
                league  = html.unescape(league).strip()
                teams   = html.unescape(teams).strip()
                is_live = 'btn-live' in time_cls
                status  = '[COLOR red]LIVE[/COLOR]' if is_live else self._fmt_utc_ts(epoch)
                title   = f'[COLOR dodgerblue]{league} {status}[/COLOR] [COLOR orange]{teams}[/COLOR]'
                results.append((href, title))
            return results or None
        except Exception as e:
            _log_error('streameast', url, e)
            return None

    @_guard
    def streameast_vg(self, url):
        try:
            base      = _base_url(url)
            page_data = requests.get(url, headers={'User-Agent': UA, 'Referer': url}, timeout=TIMEOUT).text
            matches   = re.findall(
                r'<a class="ev (?:ev-match|ev-plain)([^"]*)" href="([^"]+)" title="([^"]+)"[^>]*>(.*?)</a>',
                page_data, re.S
            )
            results = []
            for status_cls, href, title, block in matches:
                if 'is-post' in status_cls:
                    continue
                title = html.unescape(title).strip()
                if 'is-live' in status_cls:
                    label = f'[COLOR red]LIVE[/COLOR] [COLOR orange]{title}[/COLOR]'
                else:
                    time_str  = ''
                    time_match = re.search(r'<time class="ko" datetime="([^"]+)"', block)
                    if time_match:
                        try:
                            dt = datetime.strptime(time_match.group(1), '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)
                            time_str = _to_local(dt).strftime('%m/%d %I:%M %p').lstrip('0')
                        except Exception:
                            pass
                    label = self._label(time_str, title)
                results.append((urljoin(base, href), label))
            return results or None
        except Exception as e:
            _log_error('streameast_vg', url, e)
            return None

    @_guard
    def ovostreams(self, url):
        try:
            base      = _base_url(url)
            page_data = requests.get(url, headers={'User-Agent': UA, 'Referer': url}, timeout=TIMEOUT).text
            results   = []
            cards = re.split(r'(?=<div class="card" data-search=)', page_data)[1:]
            for block in cards:
                sport_m = re.search(r'<div class="sport-tag">([^<]*)</div>', block)
                teams   = re.findall(r'<div class="team-name">([^<]*)</div>', block)
                href_m  = re.search(r'<a href="([^"]+)" class="watch-btn">', block)
                if not teams or not href_m:
                    continue
                sport = html.unescape(sport_m.group(1)).strip() if sport_m else ''
                title = ' vs '.join(html.unescape(t).strip() for t in teams)
                href  = html.unescape(href_m.group(1)).strip()
                label = f'[COLOR dodgerblue]{sport}[/COLOR] [COLOR orange]{title}[/COLOR]' if sport else f'[COLOR orange]{title}[/COLOR]'
                results.append((urljoin(base, href), label))
            return results or None
        except Exception as e:
            _log_error('ovostreams', url, e)
            return None

    @_guard
    def hdrez(self, url):
        try:
            page_data = requests.get(url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
            items     = re.findall(r'<script>var.*?=\s*(\[[^;]+)', page_data)[0]
            items     = re.findall(r'"(.+?)"', items)
            subitem   = int(re.findall(r'\(atob.+?-\s*(\d+)', page_data)[0])
            srp       = ''
            for item in items:
                srp += chr(
                    int(re.sub(r'[^\d]', '', base64.b64decode(item).decode('utf-8'))) - subitem
                )
            results = re.findall(
                r'kode_ticket_text.*?h6>([^<]*).*?h2>([^<]*).*?an>([^<]*).*?h2>([^<]*).*?ef="([^"]*)',
                srp, re.S
            )
            return results or None
        except Exception as e:
            _log_error('hdrez', url, e)
            return None

