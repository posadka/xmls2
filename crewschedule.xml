    @_guard
    def streamsify(self, url):
        try:
            base    = _base_url(url)
            today   = datetime.now().astimezone().date()
            results = []
            page    = 1
            while True:
                page_url  = url if page == 1 else urljoin(base, f'/page/{page}/')
                page_data = requests.get(page_url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
                articles  = re.findall(r'<article.*?</article>', page_data, re.S)
                if not articles:
                    break
                stop = False
                for article in articles:
                    m = re.search(
                        r'<h2 class="entry-title"[^>]*><a href="([^"]+)"[^>]*>([^<]+)</a></h2>.*?datetime="([^"]+)"',
                        article, re.S
                    )
                    if not m:
                        continue
                    post_url, title, ts = m.groups()
                    try:
                        dt = datetime.strptime(ts, '%Y-%m-%dT%H:%M:%S+00:00').replace(tzinfo=timezone.utc).astimezone()
                    except Exception:
                        continue
                    if dt.date() < today:
                        stop = True
                        break
                    if dt.date() > today:
                        continue
                    title = html.unescape(title).strip()
                    results.append((post_url, self._label('', title)))
                if stop:
                    break
                page += 1
            return results or None
        except Exception as e:
            _log_error('streamsify', url, e)
            return None

