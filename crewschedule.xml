                log(f'xyzstreams_nfl: no feed url found | {url}', xbmc.LOGERROR)
                return None
            map_m      = re.search(r'const\s+NFL_STREAM_MAP\s*=\s*\{(.*?)\}\s*;', page_data, re.S)
            stream_map = dict(re.findall(r"'([A-Z]+)'\s*:\s*'([^']+)'", map_m.group(1))) if map_m else {}
            data  = requests.get(feed_m.group(1), headers={'User-Agent': UA}, timeout=TIMEOUT).json()
            games = (data.get('data') or {}).get('games', [])
            results = []
            for game in games:
                home = game.get('home_team') or {}
