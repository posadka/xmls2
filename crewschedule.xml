    @staticmethod
    def _fmt_utc_ts(ts, fmt='%m/%d %I:%M %p'):
        try:
            dt = datetime.fromtimestamp(int(ts), tz=timezone.utc).astimezone()
            return dt.strftime(fmt).lstrip('0')
        except Exception:
            return ''

    @staticmethod
    def _fmt_utc_dt(dt_str, in_fmt='%Y-%m-%d %H:%M:%S', out_fmt='%m/%d %I:%M %p'):
        try:
            dt = datetime.strptime(dt_str, in_fmt).replace(tzinfo=timezone.utc).astimezone()
            return dt.strftime(out_fmt).lstrip('0')
        except Exception:
            return ''

    @staticmethod
    def _label(time_str, title):
        if time_str:
            return f'[COLOR dodgerblue]{time_str}[/COLOR] [COLOR orange]{title}[/COLOR]'
        return f'[COLOR orange]{title}[/COLOR]'

    @_guard
    def rampages(self, url):
        try:
            page_data = requests.get(url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
            base      = _base_url(url)
            matches   = re.findall(
                r'(?s)<tr><td data-sort="\*[^"]*"><a href="([^"]+)">'
                r'<img class="icon" src="[^"]*" alt="Directory">([^<]+)</a></td>'
                r'<td data-sort="[^"]*">([^<]+)</td>',
                page_data
            )
            entries = []
            for href, name, dt_str in matches:
                name  = html.unescape(name).strip()
                title = name.replace('-vs-', ' vs ').replace('-', ' ').title()
                dt_str = dt_str.strip()
                try:
                    dt        = datetime.strptime(dt_str, '%Y-%m-%d %H:%M').replace(tzinfo=timezone.utc)
                    time_str  = dt.astimezone().strftime('%m/%d %I:%M %p').lstrip('0')
                    sort_key  = dt
                except Exception:
                    time_str  = dt_str
                    sort_key  = datetime.max.replace(tzinfo=timezone.utc)
                full_url = urljoin(base, href)
                entries.append((sort_key, full_url, self._label(time_str, title)))
            entries.sort(key=lambda e: e[0])
            results = [(u, l) for _, u, l in entries]
            return results or None
        except Exception as e:
            _log_error('rampages', url, e)
            return None

