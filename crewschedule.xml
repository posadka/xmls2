    @_guard
    def streameast_ga(self, url):
        try:
            page_data = requests.get(url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
            base = _base_url(url)
            now = datetime.now().date()
            tomorrow = now + timedelta(days=1)

            def _date_label(ts):
                try:
                    dt = _to_local(datetime.fromtimestamp(int(ts), tz=timezone.utc))
                    event_date = dt.date()
                    if event_date == now:
                        day = 'Today'
                    elif event_date == tomorrow:
                        day = 'Tomorrow'
                    else:
                        day = dt.strftime('%m-%d')
                    return f'{day} {dt.strftime("%I:%M %p").lstrip("0")}'
                except Exception:
                    return ''

            matches = re.findall(
                r'(?s)<div\s+class="m-card\b[^"]*"([^>]*)>.*?<a\s+class="m-card__link"\s+href="([^"]+)"',
                page_data
            )
            results = []
            for attributes, href in matches:
                time_match  = re.search(r'\bdata-time="(\d+)"', attributes)
                teams_match = re.search(r'\bdata-team-names="([^"]+)"', attributes)
                if not teams_match:
                    continue
                teams_text = html.unescape(teams_match.group(1)).strip()
                teams = teams_text.split('|', 1)
                team1 = teams[0].strip()
                if len(teams) == 2:
                    team2 = teams[1].strip()
                    label_txt = f'{team1} vs {team2}'
                else:
                    label_txt = team1
                time_str = _date_label(time_match.group(1)) if time_match else ''
                if 'm-card--live' in attributes:
                    status = '[COLOR red]LIVE[/COLOR]'
                else:
                    status = f'[COLOR dodgerblue]{time_str}[/COLOR]' if time_str else ''
                label = f'{status} [COLOR orange]{label_txt}[/COLOR]'.strip()
                results.append((urljoin(base, html.unescape(href)), label))

            event_matches = re.findall(
                r'(?s)<a\s+class="(m-card\b[^"]*\bm-card--event\b[^"]*)"\s+href="([^"]+)"([^>]*)>.*?<span\s+class="m-card__title">([^<]+)</span>',
                page_data
            )
            for class_val, href, attrs, title_text in event_matches:
                time_match = re.search(r'\bdata-time="(\d+)"', attrs)
                title      = html.unescape(title_text).strip()
                time_str   = _date_label(time_match.group(1)) if time_match else ''
                if 'm-card--live' in class_val:
                    status = '[COLOR red]LIVE[/COLOR]'
                else:
                    status = f'[COLOR dodgerblue]{time_str}[/COLOR]' if time_str else ''
                label = f'{status} [COLOR orange]{title}[/COLOR]'.strip()
                results.append((urljoin(base, html.unescape(href)), label))

            if not results:
                log('streameast_ga: no matches found', xbmc.LOGERROR)
                return None
            return results
        except Exception as e:
            _log_error('streameast_ga', url, e)
            return None

