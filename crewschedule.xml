_AES_RCON = [0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36]


def _aes128_key_expansion(key):
    w = [list(key[4*i:4*i+4]) for i in range(4)]
    for i in range(4, 44):
        temp = list(w[i-1])
        if i % 4 == 0:
            temp = temp[1:] + temp[:1]
            temp = [_AES_SBOX[b] for b in temp]
            temp[0] ^= _AES_RCON[i // 4 - 1]
        w.append([w[i-4][j] ^ temp[j] for j in range(4)])
    round_keys = []
    for r in range(11):
        rk = []
        for c in range(4):
            rk += w[r*4+c]
        round_keys.append(rk)
    return round_keys


def _aes128_inv_shift_rows(state):
    s = state[:]
    for r in range(1, 4):
        row = [s[r+4*c] for c in range(4)]
        row = row[-r:] + row[:-r]
        for c in range(4):
            s[r+4*c] = row[c]
    return s


def _aes128_xtime(a):
    a <<= 1
    if a & 0x100:
        a ^= 0x11b
    return a & 0xff


def _aes128_gmul(a, b):
    p = 0
    for _ in range(8):
        if b & 1:
            p ^= a
        a = _aes128_xtime(a)
        b >>= 1
    return p & 0xff


def _aes128_inv_mix_columns(state):
    s = state[:]
    out = [0] * 16
    for c in range(4):
        col = s[4*c:4*c+4]
        out[4*c+0] = _aes128_gmul(col[0],0x0e)^_aes128_gmul(col[1],0x0b)^_aes128_gmul(col[2],0x0d)^_aes128_gmul(col[3],0x09)
        out[4*c+1] = _aes128_gmul(col[0],0x09)^_aes128_gmul(col[1],0x0e)^_aes128_gmul(col[2],0x0b)^_aes128_gmul(col[3],0x0d)
        out[4*c+2] = _aes128_gmul(col[0],0x0d)^_aes128_gmul(col[1],0x09)^_aes128_gmul(col[2],0x0e)^_aes128_gmul(col[3],0x0b)
        out[4*c+3] = _aes128_gmul(col[0],0x0b)^_aes128_gmul(col[1],0x0d)^_aes128_gmul(col[2],0x09)^_aes128_gmul(col[3],0x0e)
    return out


def _aes128_decrypt_block(key, block):
    rks = _aes128_key_expansion(key)
    state = [block[i] ^ rks[10][i] for i in range(16)]
    for rnd in range(9, 0, -1):
        state = _aes128_inv_shift_rows(state)
        state = [_AES_RSBOX[b] for b in state]
        state = [state[i] ^ rks[rnd][i] for i in range(16)]
        state = _aes128_inv_mix_columns(state)
    state = _aes128_inv_shift_rows(state)
    state = [_AES_RSBOX[b] for b in state]
    state = [state[i] ^ rks[0][i] for i in range(16)]
    return state


def _solve_lyrashield(page_data):
    key_m = re.search(r'_0xff14\s*=\s*\["([^"]+)"\]', page_data)
    iv_m  = re.search(r'a1\s*=\s*atob\("([^"]+)"\)', page_data)
    ct_m  = re.search(r'b1\s*=\s*toNumbers\("([^"]+)"\)', page_data)
    if not (key_m and iv_m and ct_m):
        return None
    key = bytes.fromhex(base64.b64decode(key_m.group(1)).decode())
    iv  = bytes.fromhex(base64.b64decode(iv_m.group(1)).decode())
    ct  = bytes.fromhex(ct_m.group(1))
    pt  = _aes128_decrypt_block(list(key), list(ct))
    return bytes(a ^ b for a, b in zip(pt, iv)).hex()


_IS_XBOX = None


def _is_xbox():
    global _IS_XBOX
    if _IS_XBOX is None:
        try:
            _IS_XBOX = bool(xbmc.getCondVisibility('System.Platform.Xbox'))
        except Exception:
            _IS_XBOX = False
    return _IS_XBOX


def _to_local(dt_utc):
    """Convert an aware UTC datetime to local wall-clock time. Skipped on Xbox
    (UWP sandbox) - datetime.astimezone()'s system-timezone lookup isn't
    reliable there, so times are left in UTC on that platform rather than
    crashing or silently returning wrong values."""
    if _is_xbox():
        return dt_utc.astimezone(timezone.utc)
    return dt_utc.astimezone()


def _guard(func):
    def wrapper(self, url):
        if control.infoLabel('Container.PluginName') != 'plugin.video.thecrew':
            return None
        return func(self, url)
    wrapper.__name__ = func.__name__
    return wrapper


