                if len(divs) < 2:
                    continue
                league = html.unescape(re.sub(r'<[^>]+>', '', divs[0])).strip()
                status = html.unescape(re.sub(r'<[^>]+>', '', divs[1])).strip()
                if status.upper() == 'LIVE':
                    time_str = '[COLOR red]LIVE[/COLOR]'
                else:
                    time_str = f'[COLOR dodgerblue]{status}[/COLOR]'
                label = f'{time_str} [COLOR gray]{league}[/COLOR] [COLOR orange]{event_name}[/COLOR]'
                results.append((href, label))
            return results or None
        except Exception as e:
            _log_error('sportsurge', url, e)
            return None

    @_guard
    def streamsify(self, url):
        try:
            base    = _base_url(url)
            today   = datetime.now().date()
            results = []
            page    = 1
            while True:
                page_url  = url if page == 1 else urljoin(base, f'/page/{page}/')
                page_data = requests.get(page_url, headers={'User-Agent': UA}, timeout=TIMEOUT).text
                articles  = re.findall(r'<article.*?</article>', page_data, re.S)
                if not articles:
                    break
                stop = False
                for article in articles:
                    m = re.search(
                        r'<h2 class="entry-title"[^>]*><a href="([^"]+)"[^>]*>([^<]+)</a></h2>.*?datetime="([^"]+)"',
                        article, re.S
                    )
                    if not m:
                        continue
                    post_url, title, ts = m.groups()
                    try:
                        dt = _to_local(datetime.strptime(ts, '%Y-%m-%dT%H:%M:%S+00:00').replace(tzinfo=timezone.utc))
                    except Exception:
                        continue
                    if dt.date() < today:
                        stop = True
                        break
                    if dt.date() > today:
                        continue
                    title = html.unescape(title).strip()
                    results.append((post_url, self._label('', title)))
                if stop:
                    break
                page += 1
            return results or None
        except Exception as e:
            _log_error('streamsify', url, e)
            return None

    @_guard
    def timstreams(self, url):
        try:
            origin  = _base_url(url)
            headers = {
                'User-Agent': UA,
                'Referer': origin + '/',
                'Accept': 'application/json, text/plain, */*',
            }
            session = requests.Session()
            resp = session.get(url, headers=headers, timeout=TIMEOUT)
            try:
                data = resp.json()
            except Exception:
                cookie_val = _solve_lyrashield(resp.text)
                if not cookie_val:
                    log(f'timstreams: bad JSON status={resp.status_code} | {url} | body: {resp.text[:200]!r}', xbmc.LOGERROR)
                    return None
                session.cookies.set('LyraShield-vA', cookie_val, domain=urlparse(origin).netloc)
                resp = session.get(url, headers=headers, timeout=TIMEOUT)
                try:
                    data = resp.json()
                except Exception:
                    log(f'timstreams: bad JSON after challenge solve status={resp.status_code} | {url} | body: {resp.text[:200]!r}', xbmc.LOGERROR)
                    return None
            results = []
            for ch in data.get('channels', []):
                for s in ch.get('streams', []):
                    stream_url = s.get('url', '')
                    if not stream_url:
                        continue
                    label = f'[COLOR orange]{ch.get("name", "")}[/COLOR]'
                    results.append((stream_url, label))
            return results or None
        except Exception as e:
            _log_error('timstreams', url, e)
            return None

