                home_abbr = home.get('short_name') or 'HOME'
                away_abbr = away.get('short_name') or 'AWAY'
                status = (game.get('game_status') or '').lower()
                if status in ('final', 'completed'):
                    continue
                home_name = home.get('name') or home.get('short_name') or 'Home'
                slug      = re.sub(r'[^a-z]', '', home_name.lower())
                page_path = stream_map.get(home_abbr) or f'247.html?streamid={slug}&proid=nfl'
                title     = f'{away.get("name") or away_abbr} @ {home_name}'
                clock     = (game.get('clock') or '').strip()
                if (status in ('in progress', 'live') or game.get('active') is True) and clock and not clock.lower().startswith('0 '):
                    time_str = '[COLOR red]LIVE[/COLOR]'
                else:
                    time_str = ''
                    dt_str = game.get('datetime')
                    if dt_str:
                        try:
                            dt = _to_local(datetime.strptime(dt_str, '%Y-%m-%dT%H:%M:%S+00:00').replace(tzinfo=timezone.utc))
                            time_str = f'[COLOR dodgerblue]{dt.strftime("%m/%d %I:%M %p").lstrip("0")}[/COLOR]'
                        except Exception:
                            pass
                label = f'{time_str} [COLOR orange]{title}[/COLOR]'.strip()
                results.append((urljoin(base + '/', page_path), label))
            return results or None
        except Exception as e:
            _log_error('xyzstreams_nfl', url, e)
            return None

